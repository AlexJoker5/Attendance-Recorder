# Local preview is available ONLY through the Vite development server.
VITE_DATA_MODE=local
# Connected authentication; do not put a service-role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional Cloudflare Worker origin. Keep VITE_SUPABASE_URL as the original project URL.
# Example: https://attendance-api.YOUR_SUBDOMAIN.workers.dev (no /health suffix)
VITE_SUPABASE_PROXY_URL=
