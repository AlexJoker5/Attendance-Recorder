{
  "name": "attendance-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180",
    "typecheck": "tsc -b",
    "lint": "eslint src api cloudflare/supabase-proxy/src cloudflare/supabase-proxy/scripts",
    "format": "prettier --write src api *.json *.ts *.js index.html cloudflare/supabase-proxy",
    "format:check": "prettier --check src api *.json *.ts *.js index.html cloudflare/supabase-proxy",
    "typecheck:worker": "tsc -p cloudflare/supabase-proxy/tsconfig.json",
    "build:worker": "npm run typecheck:worker && node cloudflare/supabase-proxy/scripts/buildWorker.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "8.21.3",
    "i18next": "26.4.2",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  }
}
